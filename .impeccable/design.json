  "narrative": {
    "northStar": "Operate — native RTL",
    "overview": "The approved iOS replacement uses the supplied CBTipul color guide, Rubik typography and a native Hebrew RTL workspace. White and pale-blue surfaces in light appearance become layered navy surfaces in dark appearance, with the same clear action hierarchy and record-type meaning. The existing logo is retained; no new raster imagery is introduced.\n\nThis is the app-wide iOS visual system. It supersedes the earlier iOS paper/plum palette, system-type direction and patient-colored header planes. Source authority is ios/Theme.swift and ios/BrandTypography.swift. Existing surface briefs retain interaction contracts; conflicting historical palette and typography descriptions defer here. Android and web have not been migrated by this work.",
    "keyCharacteristics": [
      "Rubik with native Dynamic Type and Hebrew RTL.",
      "White and pale-blue light surfaces; coordinated navy dark surfaces.",
      "Turquoise new-session action and distinct record-type tiles.",
      "Native controls, preserved destinations and clinical meaning."
    ],
    "rules": [
      {
        "name": "The Meaning Rule",
        "body": "Entity tints identify record types. Severity fills use navy ink and explicit labels; success, warning and error retain their clinical/status meaning. Clinical improvement follows the instrument's meaning, not the direction of a number alone.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do resolve colors through Theme and text through BrandTypography.",
      "Do preserve Hebrew RTL, Dynamic Type, labeled actions and existing safety behavior.",
      "Do pair record-type and clinical colors with text or symbols.",
      "Do keep the newest journey stage at the left horizontally and at the top vertically."
    ],
    "donts": [
      "Don't reintroduce paper/plum iOS tokens or patient-colored header planes.",
      "Don't treat entity tints as clinical severity or infer improvement from raw score direction.",
      "Don't claim this iOS replacement migrated Android or web.",
      "Don't replace the retained logo or native controls with new raster assets or web controls."
    ]
  }
}
